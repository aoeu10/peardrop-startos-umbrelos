{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@engine/*": ["src/engine/*"],
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "../src/engine/hyperdrive/holepunch.d.ts"
  ]
}
